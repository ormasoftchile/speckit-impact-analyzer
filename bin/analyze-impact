#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# Spec-Kit Impact Analyzer
# Measure and showcase AI-assisted development impact
# ═══════════════════════════════════════════════════════════════════════

set -euo pipefail

VERSION="2.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"

# Analysis mode: "snapshot" (legacy) or "diff" (new)
ANALYSIS_MODE="snapshot"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ═══════════════════════════════════════════════════════════════════════
# UTILITY FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1" >&2; }
log_header() { echo -e "\n${BOLD}${CYAN}$1${NC}"; }

usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] [PROJECT_PATH]

Analyze AI-assisted development impact for a project.

Modes:
  Snapshot Mode (default): Analyze entire codebase as-is
  Diff Mode: Analyze only changes between two points in git history

Arguments:
  PROJECT_PATH    Path to project (default: current directory)

Common Options:
  -c, --config FILE    Config file path (default: impact-config.yaml)
  -o, --output FILE    Output report path (default: IMPACT_REPORT.md)
  -j, --json           Also output JSON metrics
  -q, --quiet          Suppress progress output
  -v, --version        Show version
  -h, --help           Show this help

Diff Mode Options (measures changes, not total codebase):
  --since DATE         Analyze commits since date (e.g., "2025-01-01")
  --until DATE         Analyze commits until date (default: now)
  --baseline REF       Compare against git ref (commit, tag, branch)
  --compare REF        Compare to git ref (default: HEAD)
  --author PATTERN     Filter commits by author

Examples:
  $(basename "$0")                                    # Snapshot: analyze entire codebase
  $(basename "$0") --since "2025-01-01"               # Diff: changes since date
  $(basename "$0") --baseline v1.0.0 --compare HEAD   # Diff: changes between refs
  $(basename "$0") --since "2025-01-01" --author "me" # Diff: my changes since date
  $(basename "$0") -c custom-config.yaml -j           # Snapshot: custom config + JSON
EOF
}

check_dependencies() {
    local missing=()
    
    command -v cloc >/dev/null 2>&1 || missing+=("cloc")
    command -v jq >/dev/null 2>&1 || missing+=("jq")
    command -v git >/dev/null 2>&1 || missing+=("git")
    command -v yq >/dev/null 2>&1 || missing+=("yq")
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Missing dependencies: ${missing[*]}"
        echo "Install with: brew install ${missing[*]}"
        exit 1
    fi
}

# ═══════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

load_config() {
    local config_file="$1"
    
    if [[ ! -f "$config_file" ]]; then
        log_warn "Config file not found: $config_file"
        log_info "Using default configuration"
        
        # Set defaults
        PROJECT_NAME="$(basename "$PROJECT_PATH")"
        PROJECT_TYPE="unknown"
        SOURCE_DIR="src/"
        TEST_DIR="test/"
        SPECS_DIR="specs/"
        EXCLUDE_DIRS="node_modules,out,dist,.vscode-test"
        
        MULT_BOILERPLATE=0.5
        MULT_GLUE=1.5
        MULT_LOGIC=4.0
        
        AI_BOILERPLATE=90
        AI_GLUE=70
        AI_LOGIC=30
        
        SESSION_GAP_HOURS=2
        SESSION_BUFFER_MINUTES=30
        AI_EFFICIENCY_FACTOR=1.0
        PATTERN_BOILERPLATE=""
        PATTERN_GLUE=""
        PATTERN_LOGIC=""
        SPECKIT_ENABLED=true
        SPECS_ROOT=""  # Empty means relative to PROJECT_PATH; can be absolute or relative to git root
        RESOLVED_SPECS_PATH=""  # Will be set by analyze_speckit
        return
    fi
    
    log_info "Loading config: $config_file"
    
    # Load values from YAML
    PROJECT_NAME=$(yq '.project.name // "Unknown"' "$config_file")
    PROJECT_TYPE=$(yq '.project.type // "unknown"' "$config_file")
    SOURCE_DIR=$(yq '.paths.source // "src/"' "$config_file")
    TEST_DIR=$(yq '.paths.tests // "test/"' "$config_file")
    SPECS_DIR=$(yq '.paths.specs // "specs/"' "$config_file")
    EXCLUDE_DIRS=$(yq '.paths.exclude | join(",") // "node_modules,out,dist"' "$config_file")
    
    MULT_BOILERPLATE=$(yq '.multipliers.boilerplate // 0.5' "$config_file")
    MULT_GLUE=$(yq '.multipliers.glue_code // 1.5' "$config_file")
    MULT_LOGIC=$(yq '.multipliers.core_logic // 4.0' "$config_file")
    MULT_TEST=$(yq '.multipliers.tests // 1.5' "$config_file")
    
    AI_BOILERPLATE=$(yq '.ai_percent.boilerplate // 90' "$config_file")
    AI_GLUE=$(yq '.ai_percent.glue_code // 70' "$config_file")
    AI_LOGIC=$(yq '.ai_percent.core_logic // 30' "$config_file")
    AI_TEST=$(yq '.ai_percent.tests // 75' "$config_file")
    
    SESSION_GAP_HOURS=$(yq '.git.session_gap_hours // 2' "$config_file")
    SESSION_BUFFER_MINUTES=$(yq '.git.session_buffer_minutes // 30' "$config_file")
    
    # AI efficiency factor accounts for review/debug overhead (0.0-1.0)
    AI_EFFICIENCY_FACTOR=$(yq '.ai_percent.efficiency_factor // 1.0' "$config_file")
    
    # Classification patterns from config (fallback to defaults if not set)
    PATTERN_BOILERPLATE=$(yq '.classification.boilerplate | join("|") // ""' "$config_file")
    PATTERN_GLUE=$(yq '.classification.glue_code | join("|") // ""' "$config_file")
    PATTERN_LOGIC=$(yq '.classification.core_logic | join("|") // ""' "$config_file")
    
    # Handle boolean properly - yq's // operator doesn't work with false
    local speckit_val
    speckit_val=$(yq '.speckit.enabled' "$config_file")
    if [[ "$speckit_val" == "null" ]] || [[ -z "$speckit_val" ]]; then
        SPECKIT_ENABLED="true"
    else
        SPECKIT_ENABLED="$speckit_val"
    fi
    
    # Specs root - can be absolute, relative to project, or relative to git root
    SPECS_ROOT=$(yq '.speckit.specs_root // ""' "$config_file")
}

# ═══════════════════════════════════════════════════════════════════════
# METRICS COLLECTION
# ═══════════════════════════════════════════════════════════════════════

collect_code_metrics() {
    log_header "📊 Collecting Code Metrics"
    
    local source_path="${PROJECT_PATH}/${SOURCE_DIR}"
    
    if [[ ! -d "$source_path" ]]; then
        log_warn "Source directory not found: $source_path"
        TOTAL_LOC=0
        TOTAL_FILES=0
        return
    fi
    
    # Get cloc output as JSON
    CLOC_OUTPUT=$(cloc "$source_path" --exclude-dir="$EXCLUDE_DIRS" --json 2>/dev/null || echo '{}')
    
    # Extract totals
    TOTAL_LOC=$(echo "$CLOC_OUTPUT" | jq '.SUM.code // 0')
    TOTAL_FILES=$(echo "$CLOC_OUTPUT" | jq '.SUM.nFiles // 0')
    TOTAL_COMMENTS=$(echo "$CLOC_OUTPUT" | jq '.SUM.comment // 0')
    TOTAL_BLANK=$(echo "$CLOC_OUTPUT" | jq '.SUM.blank // 0')
    
    # Get per-file breakdown
    CLOC_BY_FILE=$(cloc "$source_path" --exclude-dir="$EXCLUDE_DIRS" --by-file --json 2>/dev/null || echo '{}')
    
    log_success "Found $TOTAL_FILES files with $TOTAL_LOC lines of code"
}

collect_test_metrics() {
    log_header "🧪 Collecting Test Metrics"
    
    local test_path="${PROJECT_PATH}/${TEST_DIR}"
    
    # Initialize test metrics
    TEST_LOC=0
    TEST_FILES=0
    TEST_COMMENTS=0
    TEST_RATIO=0
    
    if [[ ! -d "$test_path" ]]; then
        log_warn "Test directory not found: $test_path"
        return
    fi
    
    # Get test code metrics
    local test_cloc
    test_cloc=$(cloc "$test_path" --exclude-dir="node_modules,coverage,__snapshots__" --json 2>/dev/null || echo '{}')
    
    TEST_LOC=$(echo "$test_cloc" | jq '.SUM.code // 0')
    TEST_FILES=$(echo "$test_cloc" | jq '.SUM.nFiles // 0')
    TEST_COMMENTS=$(echo "$test_cloc" | jq '.SUM.comment // 0')
    
    # Calculate test-to-code ratio
    if [[ $TOTAL_LOC -gt 0 && $TEST_LOC -gt 0 ]]; then
        TEST_RATIO=$(echo "scale=2; $TEST_LOC * 100 / $TOTAL_LOC" | bc)
    else
        TEST_RATIO=0
    fi
    
    log_success "Found $TEST_FILES test files with $TEST_LOC lines of test code (${TEST_RATIO}% of source)"
}

classify_files() {
    log_header "🏷️  Classifying Files"
    
    # Initialize counters
    LOC_BOILERPLATE=0
    LOC_GLUE=0
    LOC_LOGIC=0
    FILES_BOILERPLATE=0
    FILES_GLUE=0
    FILES_LOGIC=0
    
    local source_path="${PROJECT_PATH}/${SOURCE_DIR}"
    
    if [[ ! -d "$source_path" ]]; then
        return
    fi
    
    # Build classification patterns (use config or fall back to defaults)
    local pattern_boilerplate="${PATTERN_BOILERPLATE:-extension\.ts|types/|config/|\.d\.ts|config\.ts|layouts/|interfaces/}"
    local pattern_glue="${PATTERN_GLUE:-commands/|utils/|webview/|handlers/|components/|pages/|hooks/|services/}"
    # Note: pattern_logic is used as fallback (files not matching boilerplate or glue)
    
    # Classify files based on path patterns
    while IFS= read -r file; do
        local loc
        loc=$(echo "$CLOC_BY_FILE" | jq --arg f "$file" '.[$f].code // 0')
        
        # Classify based on config-driven patterns
        if [[ -n "$pattern_boilerplate" ]] && [[ "$file" =~ ($pattern_boilerplate) ]]; then
            LOC_BOILERPLATE=$((LOC_BOILERPLATE + loc))
            FILES_BOILERPLATE=$((FILES_BOILERPLATE + 1))
        elif [[ -n "$pattern_glue" ]] && [[ "$file" =~ ($pattern_glue) ]]; then
            LOC_GLUE=$((LOC_GLUE + loc))
            FILES_GLUE=$((FILES_GLUE + 1))
        else
            # Default to core logic
            LOC_LOGIC=$((LOC_LOGIC + loc))
            FILES_LOGIC=$((FILES_LOGIC + 1))
        fi
    done < <(echo "$CLOC_BY_FILE" | jq -r 'keys[]' | grep -E '\.(ts|js|py|go|rs|astro|tsx|jsx|vue|svelte|md)$' || true)
    
    log_success "Classified: Boilerplate=$FILES_BOILERPLATE, Glue=$FILES_GLUE, Logic=$FILES_LOGIC files"
}

analyze_git_timeline() {
    log_header "⏱️  Analyzing Git Timeline"
    
    cd "$PROJECT_PATH"
    
    if [[ ! -d .git ]]; then
        log_warn "Not a git repository"
        GIT_FIRST_COMMIT=""
        GIT_LAST_COMMIT=""
        GIT_TOTAL_COMMITS=0
        GIT_ESTIMATED_HOURS=0
        return
    fi
    
    # Get commit timestamps
    GIT_FIRST_COMMIT=$(git log --format="%ai" --reverse | head -1 || echo "")
    GIT_LAST_COMMIT=$(git log --format="%ai" -1 || echo "")
    GIT_TOTAL_COMMITS=$(git rev-list --count HEAD 2>/dev/null || echo "0")
    
    # Estimate development hours based on commit sessions
    # A session is a group of commits within SESSION_GAP_HOURS of each other
    local prev_timestamp=0
    local session_count=0
    local total_session_time=0
    local session_start=0
    local gap_seconds=$((SESSION_GAP_HOURS * 3600))
    
    while IFS= read -r timestamp; do
        local current
        current=$(date -j -f "%Y-%m-%d %H:%M:%S %z" "$timestamp" "+%s" 2>/dev/null || date -d "$timestamp" "+%s" 2>/dev/null || echo "0")
        
        if [[ $prev_timestamp -eq 0 ]]; then
            session_start=$current
            session_count=1
        elif [[ $((current - prev_timestamp)) -gt $gap_seconds ]]; then
            # New session - add previous session time with configurable buffer
            local buffer_seconds=$((SESSION_BUFFER_MINUTES * 60))
            total_session_time=$((total_session_time + prev_timestamp - session_start + buffer_seconds))
            session_start=$current
            session_count=$((session_count + 1))
        fi
        prev_timestamp=$current
    done < <(git log --format="%ai" --reverse)
    
    # Add final session with configurable buffer
    if [[ $prev_timestamp -gt 0 ]] && [[ $session_start -gt 0 ]]; then
        local buffer_seconds=$((SESSION_BUFFER_MINUTES * 60))
        total_session_time=$((total_session_time + prev_timestamp - session_start + buffer_seconds))
    fi
    
    GIT_ESTIMATED_HOURS=$(echo "scale=1; $total_session_time / 3600" | bc)
    GIT_SESSION_COUNT=$session_count
    
    log_success "Found $GIT_TOTAL_COMMITS commits in ~$GIT_SESSION_COUNT sessions (~${GIT_ESTIMATED_HOURS}h estimated)"
}

analyze_speckit() {
    log_header "📋 Analyzing Spec-Kit Usage"
    
    # Check if speckit analysis is enabled
    if [[ "$SPECKIT_ENABLED" == "false" ]]; then
        log_info "Spec-Kit analysis disabled in config"
        SPEC_LINES=0
        SPEC_TASKS_TOTAL=0
        SPEC_TASKS_COMPLETE=0
        SPEC_FILES=0
        return
    fi
    
    # Determine specs path with fallback search
    local specs_path=""
    
    # 1. If SPECS_ROOT is set, use it (absolute or relative to git root)
    if [[ -n "$SPECS_ROOT" ]]; then
        if [[ "$SPECS_ROOT" == /* ]]; then
            # Absolute path
            specs_path="$SPECS_ROOT"
        else
            # Relative to git root
            local git_root
            git_root=$(cd "$PROJECT_PATH" && git rev-parse --show-toplevel 2>/dev/null || echo "")
            if [[ -n "$git_root" ]]; then
                specs_path="${git_root}/${SPECS_ROOT}"
            fi
        fi
    fi
    
    # 2. Try relative to PROJECT_PATH
    if [[ -z "$specs_path" ]] || [[ ! -d "$specs_path" ]]; then
        specs_path="${PROJECT_PATH}/${SPECS_DIR}"
    fi
    
    # 3. Fallback: search git root for specs directory
    if [[ ! -d "$specs_path" ]]; then
        local git_root
        git_root=$(cd "$PROJECT_PATH" && git rev-parse --show-toplevel 2>/dev/null || echo "")
        if [[ -n "$git_root" ]] && [[ "$git_root" != "$PROJECT_PATH" ]]; then
            local git_specs="${git_root}/${SPECS_DIR}"
            if [[ -d "$git_specs" ]]; then
                log_info "Found specs at git root: $git_specs"
                specs_path="$git_specs"
            fi
        fi
    fi
    
    if [[ ! -d "$specs_path" ]]; then
        log_warn "Specs directory not found (searched project and git root)"
        SPEC_LINES=0
        SPEC_TASKS_TOTAL=0
        SPEC_TASKS_COMPLETE=0
        SPEC_FILES=0
        RESOLVED_SPECS_PATH=""
        return
    fi
    
    # Store resolved path for JSON output (enables deduplication in portfolio aggregator)
    RESOLVED_SPECS_PATH=$(cd "$specs_path" && pwd)
    log_info "Using specs from: $RESOLVED_SPECS_PATH"
    
    # Count spec lines
    SPEC_LINES=$(find "$specs_path" -name "*.md" -exec cat {} \; 2>/dev/null | wc -l | tr -d ' ')
    
    # Count tasks - handle both formats: "T001" and "**T001**"
    SPEC_TASKS_TOTAL=$(grep -rE '^\s*-\s*\[.\]\s*(\*\*)?T[0-9]+' "$specs_path" 2>/dev/null | wc -l | tr -d ' ')
    SPEC_TASKS_COMPLETE=$(grep -rE '^\s*-\s*\[x\]\s*(\*\*)?T[0-9]+' "$specs_path" 2>/dev/null | wc -l | tr -d ' ')
    
    # Count spec files
    SPEC_FILES=$(find "$specs_path" -name "*.md" | wc -l | tr -d ' ')
    
    log_success "Found $SPEC_LINES lines in $SPEC_FILES spec files, $SPEC_TASKS_COMPLETE/$SPEC_TASKS_TOTAL tasks complete"
}

# ═══════════════════════════════════════════════════════════════════════
# DIFF MODE ANALYSIS
# Analyze git diff between two points rather than snapshot of codebase
# ═══════════════════════════════════════════════════════════════════════

collect_diff_metrics() {
    log_header "📊 Collecting Diff Metrics"
    
    cd "$PROJECT_PATH"
    
    if [[ ! -d .git ]]; then
        log_error "Diff mode requires a git repository"
        exit 1
    fi
    
    # Build git log/diff command based on options
    local git_opts=()
    
    if [[ -n "$DIFF_SINCE" ]]; then
        git_opts+=("--since=$DIFF_SINCE")
    fi
    if [[ -n "$DIFF_UNTIL" ]]; then
        git_opts+=("--until=$DIFF_UNTIL")
    fi
    if [[ -n "$DIFF_AUTHOR" ]]; then
        git_opts+=("--author=$DIFF_AUTHOR")
    fi
    
    # Determine diff range
    local diff_range=""
    if [[ -n "$DIFF_BASELINE" ]]; then
        diff_range="${DIFF_BASELINE}..${DIFF_COMPARE}"
        log_info "Comparing: $DIFF_BASELINE → $DIFF_COMPARE"
    else
        # Use git log with date filters to find commit range
        local first_commit last_commit
        first_commit=$(git log "${git_opts[@]}" --format="%H" --reverse 2>/dev/null | head -1 || echo "")
        last_commit=$(git log "${git_opts[@]}" --format="%H" -1 2>/dev/null || echo "")
        
        if [[ -z "$first_commit" ]]; then
            log_error "No commits found matching the criteria"
            exit 1
        fi
        
        # Get parent of first commit as baseline (or empty tree if first commit)
        local baseline
        baseline=$(git rev-parse "${first_commit}^" 2>/dev/null || git hash-object -t tree /dev/null)
        diff_range="${baseline}..${last_commit}"
        log_info "Analyzing commits: ${first_commit:0:8}..${last_commit:0:8}"
    fi
    
    # Count commits in range
    DIFF_COMMIT_COUNT=$(git rev-list --count $diff_range 2>/dev/null || echo "0")
    log_info "Found $DIFF_COMMIT_COUNT commits in range"
    
    # Get diff statistics
    # Format: added deleted filename
    local diff_stats
    diff_stats=$(git diff --numstat $diff_range 2>/dev/null || echo "")
    
    # Initialize counters
    DIFF_FILES_CREATED=0
    DIFF_FILES_MODIFIED=0
    DIFF_FILES_DELETED=0
    DIFF_LINES_ADDED=0
    DIFF_LINES_REMOVED=0
    
    while IFS=$'\t' read -r added removed filename; do
        [[ -z "$filename" ]] && continue
        # Skip binary files (shown as -)
        [[ "$added" == "-" ]] && continue
        
        # Skip excluded directories
        local skip=false
        IFS=',' read -ra EXCLUDES <<< "$EXCLUDE_DIRS"
        for exclude in "${EXCLUDES[@]}"; do
            if [[ "$filename" == "$exclude"* ]] || [[ "$filename" == *"/$exclude/"* ]]; then
                skip=true
                break
            fi
        done
        $skip && continue
        
        DIFF_LINES_ADDED=$((DIFF_LINES_ADDED + added))
        DIFF_LINES_REMOVED=$((DIFF_LINES_REMOVED + removed))
    done <<< "$diff_stats"
    
    DIFF_NET_LINES=$((DIFF_LINES_ADDED - DIFF_LINES_REMOVED))
    
    # Determine file status (created/modified/deleted) using diff --name-status
    local status_output
    status_output=$(git diff --name-status $diff_range 2>/dev/null || echo "")
    
    while IFS=$'\t' read -r status filename rest; do
        [[ -z "$filename" ]] && continue
        
        # Skip excluded directories
        local skip=false
        IFS=',' read -ra EXCLUDES <<< "$EXCLUDE_DIRS"
        for exclude in "${EXCLUDES[@]}"; do
            if [[ "$filename" == "$exclude"* ]] || [[ "$filename" == *"/$exclude/"* ]]; then
                skip=true
                break
            fi
        done
        $skip && continue
        
        case "$status" in
            A) DIFF_FILES_CREATED=$((DIFF_FILES_CREATED + 1)) ;;
            D) DIFF_FILES_DELETED=$((DIFF_FILES_DELETED + 1)) ;;
            M|R*|C*) DIFF_FILES_MODIFIED=$((DIFF_FILES_MODIFIED + 1)) ;;
        esac
    done <<< "$status_output"
    
    DIFF_TOTAL_FILES=$((DIFF_FILES_CREATED + DIFF_FILES_MODIFIED + DIFF_FILES_DELETED))
    
    log_success "Changed $DIFF_TOTAL_FILES files: +$DIFF_FILES_CREATED new, ~$DIFF_FILES_MODIFIED modified, -$DIFF_FILES_DELETED deleted"
    log_success "Lines: +$DIFF_LINES_ADDED / -$DIFF_LINES_REMOVED (net: $DIFF_NET_LINES)"
    
    # Store for later use
    DIFF_RANGE="$diff_range"
}

classify_diff_changes() {
    log_header "🏷️  Classifying Changes"
    
    cd "$PROJECT_PATH"
    
    # Initialize counters for changes
    DIFF_LOC_BOILERPLATE=0
    DIFF_LOC_GLUE=0
    DIFF_LOC_LOGIC=0
    DIFF_LOC_TESTS=0
    
    # Build classification patterns
    local pattern_boilerplate="${PATTERN_BOILERPLATE:-extension\.ts|types/|config/|\.d\.ts|config\.ts|layouts/|interfaces/}"
    local pattern_glue="${PATTERN_GLUE:-commands/|utils/|webview/|handlers/|components/|pages/|hooks/|services/}"
    local pattern_tests="${TEST_DIR:-test/}"
    
    # Classify each changed file
    local diff_stats
    diff_stats=$(git diff --numstat $DIFF_RANGE 2>/dev/null || echo "")
    
    while IFS=$'\t' read -r added removed filename; do
        [[ -z "$filename" ]] && continue
        [[ "$added" == "-" ]] && continue
        
        # Skip excluded directories
        local skip=false
        IFS=',' read -ra EXCLUDES <<< "$EXCLUDE_DIRS"
        for exclude in "${EXCLUDES[@]}"; do
            if [[ "$filename" == "$exclude"* ]] || [[ "$filename" == *"/$exclude/"* ]]; then
                skip=true
                break
            fi
        done
        $skip && continue
        
        # Net change for this file (added lines minus removed)
        local net_change=$((added - removed))
        # For classification, use added lines as the "effort" proxy
        local change_loc=$added
        
        # Classify by file path
        if [[ "$filename" == "$pattern_tests"* ]] || [[ "$filename" == *"/test/"* ]] || [[ "$filename" == *"_test."* ]] || [[ "$filename" == *".test."* ]] || [[ "$filename" == *".spec."* ]]; then
            DIFF_LOC_TESTS=$((DIFF_LOC_TESTS + change_loc))
        elif [[ -n "$pattern_boilerplate" ]] && [[ "$filename" =~ ($pattern_boilerplate) ]]; then
            DIFF_LOC_BOILERPLATE=$((DIFF_LOC_BOILERPLATE + change_loc))
        elif [[ -n "$pattern_glue" ]] && [[ "$filename" =~ ($pattern_glue) ]]; then
            DIFF_LOC_GLUE=$((DIFF_LOC_GLUE + change_loc))
        else
            DIFF_LOC_LOGIC=$((DIFF_LOC_LOGIC + change_loc))
        fi
    done <<< "$diff_stats"
    
    DIFF_LOC_SOURCE=$((DIFF_LOC_BOILERPLATE + DIFF_LOC_GLUE + DIFF_LOC_LOGIC))
    
    log_success "Classified changes: Boilerplate=$DIFF_LOC_BOILERPLATE, Glue=$DIFF_LOC_GLUE, Logic=$DIFF_LOC_LOGIC, Tests=$DIFF_LOC_TESTS"
}

calculate_diff_impact() {
    log_header "🧮 Calculating Impact (Diff Mode)"
    
    # Use DIFF_LOC_* instead of LOC_* for calculations
    LOC_BOILERPLATE=$DIFF_LOC_BOILERPLATE
    LOC_GLUE=$DIFF_LOC_GLUE
    LOC_LOGIC=$DIFF_LOC_LOGIC
    TOTAL_LOC=$DIFF_LOC_SOURCE
    TEST_LOC=$DIFF_LOC_TESTS
    
    # Set file counts (not tracked by file in diff mode)
    TOTAL_FILES=$DIFF_TOTAL_FILES
    TEST_FILES=0
    FILES_BOILERPLATE=0
    FILES_GLUE=0
    FILES_LOGIC=0
    
    # Initialize other variables that might not be set
    TEST_RATIO=0
    TOTAL_COMMENTS=0
    TOTAL_BLANK=0
    
    # Now run the standard calculation
    calculate_impact
    
    # Override with diff-specific messaging
    log_success "Diff analysis: ${AI_PERCENT_TOTAL}% AI-assisted, ${ACTUAL_SAVED_PERCENT}% time saved"
}

# ═══════════════════════════════════════════════════════════════════════
# CALCULATIONS
# ═══════════════════════════════════════════════════════════════════════

calculate_impact() {
    log_header "🧮 Calculating Impact"
    
    # AI-assisted lines
    AI_LOC_BOILERPLATE=$(echo "scale=0; $LOC_BOILERPLATE * $AI_BOILERPLATE / 100" | bc)
    AI_LOC_GLUE=$(echo "scale=0; $LOC_GLUE * $AI_GLUE / 100" | bc)
    AI_LOC_LOGIC=$(echo "scale=0; $LOC_LOGIC * $AI_LOGIC / 100" | bc)
    AI_LOC_TOTAL=$((AI_LOC_BOILERPLATE + AI_LOC_GLUE + AI_LOC_LOGIC))
    
    # Estimated manual time (hours)
    EST_TIME_BOILERPLATE=$(echo "scale=1; $LOC_BOILERPLATE * $MULT_BOILERPLATE / 100" | bc)
    EST_TIME_GLUE=$(echo "scale=1; $LOC_GLUE * $MULT_GLUE / 100" | bc)
    EST_TIME_LOGIC=$(echo "scale=1; $LOC_LOGIC * $MULT_LOGIC / 100" | bc)
    EST_TIME_TOTAL=$(echo "scale=1; $EST_TIME_BOILERPLATE + $EST_TIME_GLUE + $EST_TIME_LOGIC" | bc)
    
    # Time saved (proportional to AI assistance, adjusted by efficiency factor)
    # AI_EFFICIENCY_FACTOR accounts for review/prompt/debug overhead (1.0 = no overhead, 0.7 = 30% overhead)
    SAVED_BOILERPLATE=$(echo "scale=1; $EST_TIME_BOILERPLATE * $AI_BOILERPLATE / 100 * $AI_EFFICIENCY_FACTOR" | bc)
    SAVED_GLUE=$(echo "scale=1; $EST_TIME_GLUE * $AI_GLUE / 100 * $AI_EFFICIENCY_FACTOR" | bc)
    SAVED_LOGIC=$(echo "scale=1; $EST_TIME_LOGIC * $AI_LOGIC / 100 * $AI_EFFICIENCY_FACTOR" | bc)
    SAVED_TOTAL=$(echo "scale=1; $SAVED_BOILERPLATE + $SAVED_GLUE + $SAVED_LOGIC" | bc)
    
    # Percentages
    if [[ $TOTAL_LOC -gt 0 ]]; then
        AI_PERCENT_TOTAL=$(echo "scale=0; $AI_LOC_TOTAL * 100 / $TOTAL_LOC" | bc)
    else
        AI_PERCENT_TOTAL=0
    fi
    
    if [[ $(echo "$EST_TIME_TOTAL > 0" | bc) -eq 1 ]]; then
        SAVED_PERCENT=$(echo "scale=0; $SAVED_TOTAL * 100 / $EST_TIME_TOTAL" | bc)
    else
        SAVED_PERCENT=0
    fi
    
    # Test effort calculations
    # Test code typically takes ~1.5h/100 LoC manually, but AI accelerates by ~75%
    MULT_TEST=${MULT_TEST:-1.5}
    AI_TEST=${AI_TEST:-75}
    
    EST_TIME_TESTS=$(echo "scale=1; $TEST_LOC * $MULT_TEST / 100" | bc)
    AI_LOC_TESTS=$(echo "scale=0; $TEST_LOC * $AI_TEST / 100" | bc)
    SAVED_TESTS=$(echo "scale=1; $EST_TIME_TESTS * $AI_TEST / 100 * $AI_EFFICIENCY_FACTOR" | bc)
    
    # Grand totals including tests
    GRAND_TOTAL_LOC=$((TOTAL_LOC + TEST_LOC))
    GRAND_EST_TIME=$(echo "scale=1; $EST_TIME_TOTAL + $EST_TIME_TESTS" | bc)
    GRAND_SAVED=$(echo "scale=1; $SAVED_TOTAL + $SAVED_TESTS" | bc)
    GRAND_AI_LOC=$((AI_LOC_TOTAL + AI_LOC_TESTS))
    
    if [[ $GRAND_TOTAL_LOC -gt 0 ]]; then
        GRAND_AI_PERCENT=$(echo "scale=0; $GRAND_AI_LOC * 100 / $GRAND_TOTAL_LOC" | bc)
    else
        GRAND_AI_PERCENT=0
    fi
    
    # Calculate ACTUAL saved percent: (estimated - actual) / estimated * 100
    # This compares what it WOULD have taken vs what it ACTUALLY took
    if [[ $(echo "$GRAND_EST_TIME > 0" | bc) -eq 1 ]] && [[ $(echo "$GIT_ESTIMATED_HOURS > 0" | bc) -eq 1 ]]; then
        ACTUAL_SAVED_HOURS=$(echo "scale=1; $GRAND_EST_TIME - $GIT_ESTIMATED_HOURS" | bc)
        ACTUAL_SAVED_PERCENT=$(echo "scale=0; ($GRAND_EST_TIME - $GIT_ESTIMATED_HOURS) * 100 / $GRAND_EST_TIME" | bc)
    else
        ACTUAL_SAVED_HOURS=0
        ACTUAL_SAVED_PERCENT=0
    fi
    
    log_success "Analysis complete: ${AI_PERCENT_TOTAL}% AI-assisted, ${ACTUAL_SAVED_PERCENT}% time saved"
    if [[ $TEST_LOC -gt 0 ]]; then
        log_success "Tests: ${TEST_LOC} LoC (${AI_TEST}% AI-assisted), ${EST_TIME_TESTS}h manual → ${SAVED_TESTS}h saved"
    fi
}

# ═══════════════════════════════════════════════════════════════════════
# REPORT GENERATION
# ═══════════════════════════════════════════════════════════════════════

generate_report() {
    log_header "📝 Generating Report"
    
    local report_file="${PROJECT_PATH}/${OUTPUT_FILE}"
    local date_generated=$(date "+%Y-%m-%d")
    
    # Header section - different for diff vs snapshot mode
    if [[ "$ANALYSIS_MODE" == "diff" ]]; then
        cat > "$report_file" << 'HEADER_EOF'
# 📊 AI-Assisted Development Impact Report (Diff Mode)
HEADER_EOF
        cat >> "$report_file" << EOF

**Project**: ${PROJECT_NAME}  
**Type**: ${PROJECT_TYPE}  
**Analysis Mode**: Changes Only (Diff)  
**Generated**: ${date_generated}  
**Analyzer Version**: ${VERSION}

---

## 🔀 Change Scope

| Metric | Value |
|--------|-------|
| **Commits Analyzed** | ${DIFF_COMMIT_COUNT} |
| **Files Created** | +${DIFF_FILES_CREATED} |
| **Files Modified** | ~${DIFF_FILES_MODIFIED} |
| **Files Deleted** | -${DIFF_FILES_DELETED} |
| **Lines Added** | +${DIFF_LINES_ADDED} |
| **Lines Removed** | -${DIFF_LINES_REMOVED} |
| **Net Change** | ${DIFF_NET_LINES} lines |
EOF
        [[ -n "$DIFF_BASELINE" ]] && echo "| **Baseline Ref** | \`${DIFF_BASELINE}\` |" >> "$report_file"
        [[ -n "$DIFF_SINCE" ]] && echo "| **Since** | ${DIFF_SINCE} |" >> "$report_file"
        [[ -n "$DIFF_UNTIL" ]] && echo "| **Until** | ${DIFF_UNTIL} |" >> "$report_file"
        [[ -n "$DIFF_AUTHOR" ]] && echo "| **Author Filter** | ${DIFF_AUTHOR} |" >> "$report_file"
        
        cat >> "$report_file" << EOF

---

## Executive Summary

| Metric | Value |
|--------|-------|
| **Lines Changed** | ${DIFF_LINES_ADDED} added |
| **AI-Assisted** | ${AI_LOC_TOTAL} (${AI_PERCENT_TOTAL}%) |
| **Estimated Manual Time** | ${GRAND_EST_TIME}h |
| **Actual Dev Time** | ~${GIT_ESTIMATED_HOURS}h (${GIT_SESSION_COUNT} sessions) |
| **Time Saved** | ${ACTUAL_SAVED_HOURS}h (${ACTUAL_SAVED_PERCENT}%) |

---

## 📈 Changes by Category

| Category | Lines Added | AI-Assisted | Est. Manual | Time Saved |
|----------|-------------|-------------|-------------|------------|
| **Boilerplate** | ${LOC_BOILERPLATE} | ${AI_LOC_BOILERPLATE} (${AI_BOILERPLATE}%) | ${EST_TIME_BOILERPLATE}h | ${SAVED_BOILERPLATE}h |
| **Glue Code** | ${LOC_GLUE} | ${AI_LOC_GLUE} (${AI_GLUE}%) | ${EST_TIME_GLUE}h | ${SAVED_GLUE}h |
| **Core Logic** | ${LOC_LOGIC} | ${AI_LOC_LOGIC} (${AI_LOGIC}%) | ${EST_TIME_LOGIC}h | ${SAVED_LOGIC}h |
| **Tests** | ${TEST_LOC} | ${AI_LOC_TESTS} (${AI_TEST}%) | ${EST_TIME_TESTS}h | ${SAVED_TESTS}h |
| **TOTAL** | ${DIFF_LINES_ADDED} | ${GRAND_AI_LOC} (${GRAND_AI_PERCENT}%) | ${GRAND_EST_TIME}h | ${GRAND_SAVED}h |

> **Note**: This report analyzes only the *changes* made, not the full codebase. This provides accurate impact measurement for work on existing projects.

EOF
    else
        # Snapshot mode - original report format
        cat > "$report_file" << EOF
# 📊 AI-Assisted Development Impact Report

**Project**: ${PROJECT_NAME}  
**Type**: ${PROJECT_TYPE}  
**Generated**: ${date_generated}  
**Analyzer Version**: ${VERSION}

---

## Executive Summary

| Metric | Value |
|--------|-------|
| **Total Source LoC** | ${TOTAL_LOC} |
| **AI-Assisted LoC** | ${AI_LOC_TOTAL} (${AI_PERCENT_TOTAL}%) |
| **Estimated Manual Time** | ${GRAND_EST_TIME}h (source + tests) |
| **Actual Dev Time** | ~${GIT_ESTIMATED_HOURS}h (${GIT_SESSION_COUNT} sessions) |
| **Time Saved** | ${ACTUAL_SAVED_HOURS}h (${ACTUAL_SAVED_PERCENT}%) |

---

## 📈 Code Metrics Breakdown

| Category | Files | LoC | AI-Assisted | Est. Manual | Time Saved |
|----------|-------|-----|-------------|-------------|------------|
| **Boilerplate** | ${FILES_BOILERPLATE} | ${LOC_BOILERPLATE} | ${AI_LOC_BOILERPLATE} (${AI_BOILERPLATE}%) | ${EST_TIME_BOILERPLATE}h | ${SAVED_BOILERPLATE}h |
| **Glue Code** | ${FILES_GLUE} | ${LOC_GLUE} | ${AI_LOC_GLUE} (${AI_GLUE}%) | ${EST_TIME_GLUE}h | ${SAVED_GLUE}h |
| **Core Logic** | ${FILES_LOGIC} | ${LOC_LOGIC} | ${AI_LOC_LOGIC} (${AI_LOGIC}%) | ${EST_TIME_LOGIC}h | ${SAVED_LOGIC}h |
| **TOTAL** | ${TOTAL_FILES} | ${TOTAL_LOC} | ${AI_LOC_TOTAL} (${AI_PERCENT_TOTAL}%) | ${EST_TIME_TOTAL}h | ${SAVED_TOTAL}h |

### Category Definitions

- **Boilerplate**: Extension entry points, type definitions, configuration schemas
- **Glue Code**: Command handlers, event listeners, utility functions, UI bindings
- **Core Logic**: Unique algorithms, business rules, core functionality

---

## 🧪 Test Code Impact

| Metric | Value |
|--------|-------|
| **Test Files** | ${TEST_FILES} |
| **Test LoC** | ${TEST_LOC} |
| **Test-to-Code Ratio** | ${TEST_RATIO}% |
| **AI-Assisted Test LoC** | ${AI_LOC_TESTS} (${AI_TEST}%) |
| **Est. Manual Test Time** | ${EST_TIME_TESTS}h |
| **Test Time Saved** | ${SAVED_TESTS}h |

### Testing Insights

Writing comprehensive tests manually would have taken approximately **${EST_TIME_TESTS}h**. With AI assistance, an estimated **${SAVED_TESTS}h** was saved on test development alone.

> **Test Effort Model**: Test code @ ${MULT_TEST}h/100 LoC, ${AI_TEST}% AI-assisted

---
EOF
    fi
    
    # Common sections for both modes
    cat >> "$report_file" << EOF

## ⏱️ Development Timeline

| Metric | Value |
|--------|-------|
| **First Commit** | ${GIT_FIRST_COMMIT:-N/A} |
| **Last Commit** | ${GIT_LAST_COMMIT:-N/A} |
| **Total Commits** | ${GIT_TOTAL_COMMITS} |
| **Dev Sessions** | ${GIT_SESSION_COUNT:-N/A} |
| **Estimated Active Hours** | ${GIT_ESTIMATED_HOURS:-N/A}h |

---

## 📋 Spec-Kit Leverage

| Metric | Value |
|--------|-------|
| **Specification Lines** | ${SPEC_LINES} |
| **Specification Files** | ${SPEC_FILES:-0} |
| **Tasks Defined** | ${SPEC_TASKS_TOTAL} |
| **Tasks Completed** | ${SPEC_TASKS_COMPLETE} |

---

## 🎯 Key Insights

### Productivity Multiplier

Traditional Development: ${GRAND_EST_TIME}h estimated  
AI-Assisted Development: ${GIT_ESTIMATED_HOURS:-N/A}h actual  
Productivity Gain: ~$(if [ "$(echo "${GIT_ESTIMATED_HOURS:-0} > 0" | bc)" -eq 1 ]; then echo "scale=1; $GRAND_EST_TIME / $GIT_ESTIMATED_HOURS" | bc 2>/dev/null || echo "N/A"; else echo "N/A"; fi)x faster

---

## 📊 Methodology

This report uses a conservative estimation model:

1. **Code Classification**: Files categorized by complexity/AI-assist potential
2. **Time Multipliers**: Industry-average hours per 100 LoC without AI
3. **AI Assistance %**: Conservative estimates of Copilot contribution
4. **Session Detection**: Git commits grouped by ${SESSION_GAP_HOURS:-2}-hour gaps
EOF

    if [[ "$ANALYSIS_MODE" == "diff" ]]; then
        cat >> "$report_file" << 'EOF'
5. **Diff Analysis**: Only lines added/modified are counted, not the full codebase
EOF
    fi

    cat >> "$report_file" << EOF

### Assumptions & Limitations

- Time multipliers are estimates based on typical development
- AI assistance percentages are self-reported estimates
- Actual productivity varies by developer experience and problem domain
- Git session detection may under/over-estimate active coding time

---

*Generated by [Spec-Kit Impact Analyzer](https://github.com/ormasoftchile/speckit-impact-analyzer) v${VERSION}*
EOF

    log_success "Report saved: $report_file"
}

generate_json() {
    if [[ "$OUTPUT_JSON" != "true" ]]; then
        return
    fi
    
    local json_file="${PROJECT_PATH}/impact-metrics.json"
    
    cat > "$json_file" << EOF
{
  "version": "${VERSION}",
  "generated": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "analysis_mode": "${ANALYSIS_MODE}",
  "project": {
    "name": "${PROJECT_NAME}",
    "type": "${PROJECT_TYPE}"
  },
  "code": {
    "total_loc": ${TOTAL_LOC},
    "total_files": ${TOTAL_FILES},
    "comments": ${TOTAL_COMMENTS:-0},
    "blank": ${TOTAL_BLANK:-0}
  },
  "tests": {
    "loc": ${TEST_LOC:-0},
    "files": ${TEST_FILES:-0},
    "ratio_percent": ${TEST_RATIO:-0},
    "ai_loc": ${AI_LOC_TESTS:-0},
    "ai_percent": ${AI_TEST:-75},
    "est_manual_hours": ${EST_TIME_TESTS:-0},
    "saved_hours": ${SAVED_TESTS:-0}
  },
  "classification": {
    "boilerplate": { "files": ${FILES_BOILERPLATE}, "loc": ${LOC_BOILERPLATE} },
    "glue_code": { "files": ${FILES_GLUE}, "loc": ${LOC_GLUE} },
    "core_logic": { "files": ${FILES_LOGIC}, "loc": ${LOC_LOGIC} }
  },
  "ai_assisted": {
    "total_loc": ${AI_LOC_TOTAL},
    "percent": ${AI_PERCENT_TOTAL},
    "by_category": {
      "boilerplate": ${AI_LOC_BOILERPLATE},
      "glue_code": ${AI_LOC_GLUE},
      "core_logic": ${AI_LOC_LOGIC}
    }
  },
  "time": {
    "estimated_manual_hours": ${GRAND_EST_TIME},
    "actual_hours": ${GIT_ESTIMATED_HOURS:-0},
    "saved_hours": ${ACTUAL_SAVED_HOURS:-0},
    "saved_percent": ${ACTUAL_SAVED_PERCENT:-0}
  },
  "grand_total": {
    "loc": ${GRAND_TOTAL_LOC:-${TOTAL_LOC}},
    "ai_loc": ${GRAND_AI_LOC:-${AI_LOC_TOTAL}},
    "ai_percent": ${GRAND_AI_PERCENT:-${AI_PERCENT_TOTAL}},
    "est_manual_hours": ${GRAND_EST_TIME:-${EST_TIME_TOTAL}}
  },
  "git": {
    "first_commit": "${GIT_FIRST_COMMIT:-}",
    "last_commit": "${GIT_LAST_COMMIT:-}",
    "total_commits": ${GIT_TOTAL_COMMITS},
    "sessions": ${GIT_SESSION_COUNT:-0}
  },
  "speckit": {
    "spec_lines": ${SPEC_LINES:-0},
    "tasks_total": ${SPEC_TASKS_TOTAL:-0},
    "tasks_complete": ${SPEC_TASKS_COMPLETE:-0},
    "specs_path": "${RESOLVED_SPECS_PATH:-}"
  },
  "diff": {
    "enabled": $([ "$ANALYSIS_MODE" == "diff" ] && echo "true" || echo "false"),
    "baseline": "${DIFF_BASELINE:-}",
    "compare": "${DIFF_COMPARE:-}",
    "since": "${DIFF_SINCE:-}",
    "until": "${DIFF_UNTIL:-}",
    "commits": ${DIFF_COMMIT_COUNT:-0},
    "files_created": ${DIFF_FILES_CREATED:-0},
    "files_modified": ${DIFF_FILES_MODIFIED:-0},
    "files_deleted": ${DIFF_FILES_DELETED:-0},
    "lines_added": ${DIFF_LINES_ADDED:-0},
    "lines_removed": ${DIFF_LINES_REMOVED:-0},
    "net_lines": ${DIFF_NET_LINES:-0}
  }
}
EOF

    log_success "JSON metrics saved: $json_file"
}

# ═══════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════

main() {
    # Defaults
    PROJECT_PATH="$(pwd)"
    CONFIG_FILE="impact-config.yaml"
    OUTPUT_FILE="IMPACT_REPORT.md"
    OUTPUT_JSON="false"
    QUIET="false"
    
    # Diff mode options
    DIFF_SINCE=""
    DIFF_UNTIL=""
    DIFF_BASELINE=""
    DIFF_COMPARE="HEAD"
    DIFF_AUTHOR=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--config)
                CONFIG_FILE="$2"
                shift 2
                ;;
            -o|--output)
                OUTPUT_FILE="$2"
                shift 2
                ;;
            -j|--json)
                OUTPUT_JSON="true"
                shift
                ;;
            -q|--quiet)
                QUIET="true"
                shift
                ;;
            --since)
                DIFF_SINCE="$2"
                ANALYSIS_MODE="diff"
                shift 2
                ;;
            --until)
                DIFF_UNTIL="$2"
                shift 2
                ;;
            --baseline)
                DIFF_BASELINE="$2"
                ANALYSIS_MODE="diff"
                shift 2
                ;;
            --compare)
                DIFF_COMPARE="$2"
                shift 2
                ;;
            --author)
                DIFF_AUTHOR="$2"
                shift 2
                ;;
            -v|--version)
                echo "Spec-Kit Impact Analyzer v${VERSION}"
                exit 0
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
            *)
                PROJECT_PATH="$1"
                shift
                ;;
        esac
    done
    
    # Resolve to absolute path
    PROJECT_PATH="$(cd "$PROJECT_PATH" && pwd)"
    
    echo ""
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}${CYAN}  📊 Spec-Kit Impact Analyzer v${VERSION}${NC}"
    if [[ "$ANALYSIS_MODE" == "diff" ]]; then
        echo -e "${BOLD}${YELLOW}  Mode: DIFF (analyzing changes only)${NC}"
    else
        echo -e "${BOLD}  Mode: SNAPSHOT (full codebase)${NC}"
    fi
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "  Project: ${PROJECT_PATH}"
    echo ""
    
    # Check dependencies
    check_dependencies
    
    # Load configuration
    load_config "${PROJECT_PATH}/${CONFIG_FILE}"
    
    if [[ "$ANALYSIS_MODE" == "diff" ]]; then
        # Diff mode: analyze changes only
        collect_diff_metrics
        classify_diff_changes
        analyze_git_timeline
        analyze_speckit
        calculate_diff_impact
    else
        # Snapshot mode: analyze entire codebase (legacy behavior)
        collect_code_metrics
        collect_test_metrics
        classify_files
        analyze_git_timeline
        analyze_speckit
        calculate_impact
    fi
    
    # Generate outputs
    generate_report
    generate_json
    
    echo ""
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}${BOLD}  ✓ Analysis Complete${NC}"
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    if [[ "$ANALYSIS_MODE" == "diff" ]]; then
        echo -e "  ${BOLD}Changes Analyzed:${NC}"
        echo -e "    • $DIFF_COMMIT_COUNT commits"
        echo -e "    • +$DIFF_LINES_ADDED / -$DIFF_LINES_REMOVED lines (net: $DIFF_NET_LINES)"
        echo -e "    • $DIFF_FILES_CREATED new, $DIFF_FILES_MODIFIED modified, $DIFF_FILES_DELETED deleted files"
    else
        echo -e "  ${BOLD}Results:${NC}"
        echo -e "    • ${TOTAL_LOC} lines of source code (${AI_PERCENT_TOTAL}% AI-assisted)"
        if [[ $TEST_LOC -gt 0 ]]; then
            echo -e "    • ${TEST_LOC} lines of test code (${AI_TEST}% AI-assisted)"
        fi
    fi
    
    echo -e "    • ${GRAND_EST_TIME}h estimated manual time"
    echo -e "    • ${GIT_ESTIMATED_HOURS}h actual dev time"
    echo -e "    • ${ACTUAL_SAVED_HOURS}h saved (${ACTUAL_SAVED_PERCENT}%)"
    echo ""
    echo -e "  ${BOLD}Output:${NC}"
    echo -e "    • ${OUTPUT_FILE}"
    [[ "$OUTPUT_JSON" == "true" ]] && echo -e "    • impact-metrics.json"
    echo ""
}

main "$@"

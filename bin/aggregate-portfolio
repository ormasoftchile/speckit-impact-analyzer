#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
# Spec-Kit Portfolio Aggregator
# Combine multiple impact-metrics.json files into an executive dashboard
# ═══════════════════════════════════════════════════════════════════════

set -euo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log_info() { echo -e "${BLUE}ℹ${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1" >&2; }

usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] <json_file1> <json_file2> [json_file3...]

Aggregate multiple impact-metrics.json files into a portfolio dashboard.

Arguments:
  json_files    Paths to impact-metrics.json files from analyzed projects

Options:
  -o, --output FILE    Output report path (default: PORTFOLIO_DASHBOARD.md)
  -t, --title TEXT     Dashboard title (default: "AI-Assisted Development Portfolio")
  -v, --version        Show version
  -h, --help           Show this help

Examples:
  $(basename "$0") project1/impact-metrics.json project2/impact-metrics.json
  $(basename "$0") -o ~/portfolio.md */impact-metrics.json
  $(basename "$0") -t "My VS Code Extensions" ext1/impact-metrics.json ext2/impact-metrics.json
EOF
}

check_dependencies() {
    if ! command -v jq >/dev/null 2>&1; then
        log_error "jq is required. Install with: brew install jq"
        exit 1
    fi
}

# ═══════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════

main() {
    local output_file="PORTFOLIO_DASHBOARD.md"
    local title="AI-Assisted Development Portfolio"
    local json_files=()
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output)
                output_file="$2"
                shift 2
                ;;
            -t|--title)
                title="$2"
                shift 2
                ;;
            -v|--version)
                echo "Spec-Kit Portfolio Aggregator v${VERSION}"
                exit 0
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
            *)
                json_files+=("$1")
                shift
                ;;
        esac
    done
    
    if [[ ${#json_files[@]} -lt 1 ]]; then
        log_error "At least one impact-metrics.json file is required"
        usage
        exit 1
    fi
    
    check_dependencies
    
    echo ""
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}${CYAN}  📊 Spec-Kit Portfolio Aggregator v${VERSION}${NC}"
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo ""
    
    # Validate all files exist
    for file in "${json_files[@]}"; do
        if [[ ! -f "$file" ]]; then
            log_error "File not found: $file"
            exit 1
        fi
        log_info "Found: $file"
    done
    
    # Aggregate metrics
    local total_loc=0
    local total_ai_loc=0
    local total_est_manual=0
    local total_saved=0
    local total_actual=0
    local total_commits=0
    local total_spec_lines=0
    local total_tasks=0
    local total_tasks_complete=0
    local total_test_loc=0
    local total_test_files=0
    local total_test_saved=0
    local project_count=${#json_files[@]}
    
    # Build project rows
    local project_rows=""
    
    for file in "${json_files[@]}"; do
        local name=$(jq -r '.project.name // "Unknown"' "$file")
        local type=$(jq -r '.project.type // "unknown"' "$file")
        local loc=$(jq -r '.code.total_loc // 0' "$file")
        local ai_loc=$(jq -r '.ai_assisted.total_loc // 0' "$file")
        local ai_pct=$(jq -r '.ai_assisted.percent // 0' "$file")
        local est_manual=$(jq -r '.time.estimated_manual_hours // 0' "$file")
        local saved=$(jq -r '.time.estimated_saved_hours // 0' "$file")
        local saved_pct=$(jq -r '.time.saved_percent // 0' "$file")
        local actual=$(jq -r '.time.actual_hours // 0' "$file")
        local commits=$(jq -r '.git.total_commits // 0' "$file")
        local spec_lines=$(jq -r '.speckit.spec_lines // 0' "$file")
        local tasks=$(jq -r '.speckit.tasks_total // 0' "$file")
        local tasks_complete=$(jq -r '.speckit.tasks_complete // 0' "$file")
        
        # Test metrics
        local test_loc=$(jq -r '.tests.loc // 0' "$file")
        local test_files=$(jq -r '.tests.files // 0' "$file")
        local test_saved=$(jq -r '.tests.saved_hours // 0' "$file")
        local grand_loc=$(jq -r '.grand_total.loc // 0' "$file")
        local grand_saved=$(jq -r '.grand_total.saved_hours // 0' "$file")
        
        # Calculate productivity multiplier (using grand total)
        local productivity="N/A"
        if [[ $(echo "$actual > 0" | bc) -eq 1 ]]; then
            local grand_est=$(jq -r '.grand_total.est_manual_hours // 0' "$file")
            if [[ $(echo "$grand_est > 0" | bc) -eq 1 ]]; then
                productivity=$(echo "scale=1; $grand_est / $actual" | bc)x
            else
                productivity=$(echo "scale=1; $est_manual / $actual" | bc)x
            fi
        fi
        
        # Add to totals
        total_loc=$((total_loc + loc))
        total_ai_loc=$((total_ai_loc + ai_loc))
        total_est_manual=$(echo "$total_est_manual + $est_manual" | bc)
        total_saved=$(echo "$total_saved + $saved" | bc)
        total_actual=$(echo "$total_actual + $actual" | bc)
        total_commits=$((total_commits + commits))
        total_spec_lines=$((total_spec_lines + spec_lines))
        total_tasks=$((total_tasks + tasks))
        total_tasks_complete=$((total_tasks_complete + tasks_complete))
        total_test_loc=$((total_test_loc + test_loc))
        total_test_files=$((total_test_files + test_files))
        total_test_saved=$(echo "$total_test_saved + $test_saved" | bc)
        
        # Build row with test info
        local test_info=""
        if [[ $test_loc -gt 0 ]]; then
            test_info=" (+${test_loc} test)"
        fi
        project_rows+="| **${name}** | ${loc}${test_info} | ${ai_pct}% | ${est_manual}h | ${actual}h | ${saved}h (${saved_pct}%) | ${productivity} |"$'\n'
        
        log_success "Processed: $name"
    done
    
    # Calculate totals
    local total_ai_pct=0
    if [[ $total_loc -gt 0 ]]; then
        total_ai_pct=$(echo "scale=0; $total_ai_loc * 100 / $total_loc" | bc)
    fi
    
    local total_saved_pct=0
    if [[ $(echo "$total_est_manual > 0" | bc) -eq 1 ]]; then
        total_saved_pct=$(echo "scale=0; $total_saved * 100 / $total_est_manual" | bc)
    fi
    
    # Grand totals including tests
    local grand_total_loc=$((total_loc + total_test_loc))
    local grand_total_saved=$(echo "$total_saved + $total_test_saved" | bc)
    
    local total_productivity="N/A"
    if [[ $(echo "$total_actual > 0" | bc) -eq 1 ]]; then
        total_productivity=$(echo "scale=1; $total_est_manual / $total_actual" | bc)x
    fi
    
    local tasks_pct=0
    if [[ $total_tasks -gt 0 ]]; then
        tasks_pct=$(echo "scale=0; $total_tasks_complete * 100 / $total_tasks" | bc)
    fi
    
    # Generate report
    local date_generated=$(date "+%Y-%m-%d")
    
    cat > "$output_file" << EOF
# 📊 ${title}

**Generated**: ${date_generated}  
**Projects Analyzed**: ${project_count}  
**Analyzer Version**: ${VERSION}

---

## 🎯 Executive Summary

\`\`\`
╔════════════════════════════════════════════════════════════════════════╗
║                    AI-ASSISTED DEVELOPMENT IMPACT                       ║
╠════════════════════════════════════════════════════════════════════════╣
║  Total Projects:              ${project_count}                                         ║
║  Source Lines of Code:        $(printf "%-10s" "${total_loc}")                              ║
║  Test Lines of Code:          $(printf "%-10s" "${total_test_loc}")                              ║
║  Combined LoC:                $(printf "%-10s" "${grand_total_loc}")                              ║
║  AI-Assisted Code:            ${total_ai_loc} (${total_ai_pct}%)                              ║
║  ──────────────────────────────────────────────────────────────────── ║
║  Estimated Manual Time:       ${total_est_manual}h (source only)                      ║
║  Actual Development Time:     ${total_actual}h                                     ║
║  Time Saved (source):         ${total_saved}h (${total_saved_pct}%)                           ║
║  Time Saved (tests):          ${total_test_saved}h                                    ║
║  Total Time Saved:            ${grand_total_saved}h                                   ║
║  ──────────────────────────────────────────────────────────────────── ║
║  Average Productivity Gain:   ${total_productivity}                                     ║
╚════════════════════════════════════════════════════════════════════════╝
\`\`\`

---

## 📈 Project Breakdown

| Project | LoC | AI-Assisted | Est. Manual | Actual | Time Saved | Productivity |
|---------|-----|-------------|-------------|--------|------------|--------------|
${project_rows}| **TOTAL** | **${total_loc}** (+${total_test_loc} test) | **${total_ai_pct}%** | **${total_est_manual}h** | **${total_actual}h** | **${total_saved}h (${total_saved_pct}%)** | **${total_productivity}** |

---

## 🧪 Test Code Summary

| Metric | Value |
|--------|-------|
| **Total Test Files** | ${total_test_files} |
| **Total Test LoC** | ${total_test_loc} |
| **Test-to-Source Ratio** | $(echo "scale=0; $total_test_loc * 100 / ($total_loc + 1)" | bc)% |
| **Test Time Saved** | ${total_test_saved}h |

> Tests are highly AI-friendly (75% AI-assisted by default) due to their predictable arrange-act-assert patterns.

---

## 📋 Spec-Kit Methodology Impact

| Metric | Value |
|--------|-------|
| **Total Specification Lines** | ${total_spec_lines} |
| **Total Tasks Defined** | ${total_tasks} |
| **Tasks Completed** | ${total_tasks_complete} (${tasks_pct}%) |
| **Total Commits** | ${total_commits} |
| **Spec-to-Code Ratio** | $(echo "scale=2; $total_spec_lines / ($total_loc + 1)" | bc):1 |

---

## 🔍 Key Insights

### Time Efficiency
- **${grand_total_saved}h saved** across ${project_count} projects (${total_saved}h source + ${total_test_saved}h tests)
- Average productivity gain of **${total_productivity}** compared to traditional development
- AI assistance particularly effective for boilerplate, glue code, and tests (70-90% AI-assisted)

### Methodology Benefits
- Structured specifications enable focused AI prompts
- Task-based development provides clear checkpoints
- Spec-Kit templates accelerate project scaffolding
- Test generation highly AI-friendly due to predictable patterns

### Code Quality Maintained
- Complex core logic still requires human design (30-40% AI-assisted)
- AI excels at pattern application and repetitive code
- Human oversight essential for architecture decisions

---

## 📊 Methodology Notes

### Estimation Model
- **Boilerplate** (90% AI): Extension manifests, type definitions, configs
- **Glue Code** (70% AI): Event handlers, utility functions, UI bindings  
- **Core Logic** (30% AI): Unique algorithms, business rules, complex parsing
- **Tests** (75% AI): Arrange-act-assert patterns, edge cases, mocks

### Time Multipliers (hours per 100 LoC without AI)
- Boilerplate: 0.5h (quick, repetitive)
- Glue Code: 1.5h (moderate complexity)
- Core Logic: 4.0h (requires design thinking)
- Tests: 1.5h (pattern-based, but thorough)

### Git Session Detection
- Commits within 2 hours grouped as single session
- 30-minute buffer added per session
- Bot commits excluded from analysis

---

*Generated by [Spec-Kit Impact Analyzer](https://github.com/ormasoftchile/speckit-impact-analyzer) v${VERSION}*
EOF

    log_success "Portfolio dashboard saved: $output_file"
    
    echo ""
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}${BOLD}  ✓ Portfolio Aggregation Complete${NC}"
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo -e "  ${BOLD}Summary:${NC}"
    echo -e "    • ${project_count} projects analyzed"
    echo -e "    • ${total_loc} total lines of code"
    echo -e "    • ${total_saved}h estimated time saved"
    echo -e "    • ${total_productivity} average productivity gain"
    echo ""
    echo -e "  ${BOLD}Output:${NC} ${output_file}"
    echo ""
}

main "$@"
